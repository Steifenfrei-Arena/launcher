{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steifenfrei Arena Setup",
  "version": "1.0.0",
  "identifier": "de.steifenfrei.arena.setup",
  "build": {
    "frontendDist": "ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Steifenfrei Arena Setup",
        "url": "index.html",
        "width": 560,
        "height": 500,
        "center": true,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
